generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  image         String?
  nim_nip       String?        @unique
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  password      String?
  emailVerified DateTime?

  campusEmail     String?        @unique
  studyProgram    String?
  faculty         String?
  enrollmentYear  Int?

  accounts      Account[]
  chatSessions  ChatSession[]
  notifications Notification[]
  assignments   Report[]       @relation("AdminAssignment")
  activityLogs ActivityLog[]
  reports       Report[]
  shifts        Shift[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Report {
  id            String         @id @default(uuid())
  reportNumber  String         @unique
  title         String
  description   String         @db.Text
  location      String
  roomCode      String
  category      String
  imageBefore   String
  imageAfter    String?
  status        Status         @default(PENDING)
  priority      Priority       @default(MEDIUM)
  isVerified    Boolean        @default(false)
  userId        String
  adminId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logs          AuditLog[]
  activityLogs ActivityLog[]
  notifications Notification[]
  admin         User?          @relation("AdminAssignment", fields: [adminId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  @@index([adminId], map: "Report_adminId_fkey")
  @@index([userId], map: "Report_userId_fkey")
}

model AuditLog {
  id        String   @id @default(cuid())
  reportId  String
  status    String
  note      String?
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id])

  @@index([reportId], map: "AuditLog_reportId_fkey")
}

model Room {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  building String
}

model Shift {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  day       String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Shift_userId_fkey")
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@index([userId], map: "ChatSession_userId_fkey")
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "Message_sessionId_fkey")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  userId    String
  reportId  String?
  createdAt DateTime @default(now())
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId], map: "Notification_reportId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

enum Role {
  STUDENT
  ADMIN
}

enum Status {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MessageRole {
  USER
  ASSISTANT
}

model ActivityLog {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportId    String?
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)

  title       String
  description String?  @db.Text

  type        ActivityType

  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([reportId])
  @@index([createdAt])
}

enum ActivityType {
  REPORT_CREATED
  REPORT_UPDATED
  REPORT_VERIFIED
  REPORT_REJECTED
  REPORT_RESOLVED
  ROOM_UPDATED
  PROFILE_UPDATED
}
